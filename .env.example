# PostgreSQL 16. Geliştirme Windows, yayın Ubuntu VPS (§1).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sinavilan?schema=public"

# Auth.js v5 — `openssl rand -base64 32` ile üretilir.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# İlk kurulum admin hesabı (seed). Kodda hiçbir kimlik bilgisi sabit değildir.
SEED_ADMIN_EMAIL="admin@sinavilan.local"
SEED_ADMIN_PASSWORD="GeciciSifre123!"

# Ham IP saklanmaz; tuzlanmış hash için tuz (§7 KVKK).
IP_HASH_SALT="degistir-bu-tuzu"

# SMTP (§4.8 bildirim). Boşsa e-posta gönderimi "yapılandırılmamış" olarak loglanır.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sınav Takvimi <bildirim@sinavilan.local>"
